# PORT — port the Express server listens on
PORT=3001

# MAX_REQUEST_BODY_SIZE — max JSON request body size accepted by the API,
# in any format supported by the `bytes` package (e.g. "10kb", "1mb").
# Oversized requests are rejected with HTTP 413. Schema-capped payloads
# (e.g. a full 20-collaborator /api/v1/initialize body) are well under 2kb,
# so the default is intentionally generous headroom, not a tight fit.
MAX_REQUEST_BODY_SIZE=10kb

# REQUEST_COMPLEXITY_LIMIT — max complexity score allowed for JSON request bodies (#892).
# Protects against DoS via deeply nested structures, oversized arrays, or excessive keys.
# Requests exceeding this limit are rejected with HTTP 400 (code: request_too_complex).
# Default: 1000
REQUEST_COMPLEXITY_LIMIT=1000


# DATABASE_PATH — path to the SQLite database file (default: ../audit.db relative to src/)
DATABASE_PATH=./audit.db

# ROYALTY_CONTRACT_ID — default Soroban contract ID for /health and operator tooling
# (also accepts CONTRACT_ID). Set after deploy.sh writes .contract-id.
# ROYALTY_CONTRACT_ID=C...

# HEALTH_CACHE_TTL_MS — cache duration for /api/v1/health responses (default: 30000)
# HEALTH_CHECK_TIMEOUT_MS — Horizon probe timeout in ms (default: 5000)
# HEALTH_DEGRADED_THRESHOLD_MS — response time above which a component is "degraded" (default: 5000)

# ---------------------------------------------------------------------------
# Read-only data cache (#683)
# ---------------------------------------------------------------------------
# CACHE_TTL_MS — default TTL for all cached read-only responses (default: 30 000 ms)
# CACHE_TTL_MS=30000

# Per-namespace TTL overrides (fall back to CACHE_TTL_MS when unset):
# CACHE_COLLABORATORS_TTL_MS — TTL for GET /api/v1/collaborators/:contractId
# CACHE_CONTRACT_TTL_MS      — TTL for GET /api/v1/contract/state and /contract/info
# CACHE_HISTORY_TTL_MS       — TTL for GET /api/v1/history/:contractId
#
# Set any of these to 0 to disable caching for that namespace.
# CACHE_COLLABORATORS_TTL_MS=30000
# CACHE_CONTRACT_TTL_MS=30000
# CACHE_HISTORY_TTL_MS=30000

# STELLAR_NETWORK — target network for the deploy script and backend RPC client
# Accepted values: testnet | mainnet
# Testnet (default):
STELLAR_NETWORK=testnet
# Mainnet:
# STELLAR_NETWORK=mainnet

# STELLAR_IDENTITY — Stellar CLI key identity used by deploy.sh to sign the deploy tx
# Create with: stellar keys generate --global <name> --network <network>
STELLAR_IDENTITY=deployer

# SOROBAN_RPC_URL — Soroban RPC endpoint for smart contract interactions
# Testnet (default):
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# Mainnet:
# SOROBAN_RPC_URL=https://soroban-mainnet.stellar.org

# SERVER_SECRET_KEY — server-side signing key (only used for read-only simulation; real txs are signed client-side)
# For local development only. Use secrets manager in production.
SERVER_SECRET_KEY=S...

# SIGNING_KEY_FILE — optional path to a secrets-manager file containing the signing secret (takes precedence over SERVER_SECRET_KEY on startup and file reload)
# SIGNING_KEY_FILE=/run/secrets/server_signing_key

# Secrets Manager Configuration (Production)
# SECRETS_PROVIDER — secrets provider: "aws" | "vault" | "file" | "env" (default: auto-detect)
# SECRETS_PROVIDER=aws

# AWS Secrets Manager
# AWS_SECRET_NAME — name of the secret in AWS Secrets Manager
# AWS_REGION — AWS region (default: us-east-1)
# AWS_SECRET_NAME=stellar-signing-key
# AWS_REGION=us-east-1

# HashiCorp Vault
# VAULT_ADDR — Vault server address (e.g., https://vault.example.com:8200)
# VAULT_TOKEN — Vault authentication token
# VAULT_SECRET_PATH — path to secret in Vault (e.g., secret/data/signing-key)
# VAULT_ADDR=https://vault.example.com:8200
# VAULT_TOKEN=hvs.xxx
# VAULT_SECRET_PATH=secret/data/signing-key

# Encryption at Rest
# SECRETS_ENCRYPTION_KEY — key for encrypting secrets at rest (32+ characters recommended)
# In production, load this from a secure key management system
# SECRETS_ENCRYPTION_KEY=your-encryption-key-here

# ADMIN_ROTATE_TOKEN — bearer token required for POST /admin/rotate-key (hot-reload without redeploy)
ADMIN_ROTATE_TOKEN=

# RATE_LIMIT_ADMIN_MAX — max POST /admin/* requests per minute per IP (default: 5)
# RATE_LIMIT_ADMIN_MAX=5

# ── Ed25519 Request Signature Verification (#392) ─────────────────────────────
# SIGNATURE_VERIFICATION_ENABLED — set to "false" to log-only without rejecting
# requests (permissive mode for gradual client rollout). Default: "true".
# IMPORTANT: Must be "true" on mainnet deployments.
SIGNATURE_VERIFICATION_ENABLED=true

# SIGNATURE_MAX_AGE_MS — max age of a signed request before it is rejected as
# expired. Prevents replay of captured requests. Default: 300000 (5 minutes).
# SIGNATURE_MAX_AGE_MS=300000

# SIGNATURE_NONCE_TTL_MS — how long the server remembers a nonce to block
# replay attacks. Should be >= SIGNATURE_MAX_AGE_MS. Default: 600000 (10 min).
# SIGNATURE_NONCE_TTL_MS=600000

# SIGNATURE_NONCE_MAX_ENTRIES — maximum number of nonces held in memory.
# Each entry is ~200 bytes. 50000 entries ≈ 10 MB. Default: 50000.
# SIGNATURE_NONCE_MAX_ENTRIES=50000

# HORIZON_URL — Horizon REST API endpoint for account and transaction queries
# Testnet (default):
HORIZON_URL=https://horizon-testnet.stellar.org
# Mainnet:
# HORIZON_URL=https://horizon.stellar.org

# FRONTEND_ORIGIN — allowed CORS origin (your frontend URL)
FRONTEND_ORIGIN=http://localhost:5173

# CORS_PREFLIGHT_MAX_AGE — Access-Control-Max-Age for preflight responses in seconds (default: 24 hours)
CORS_PREFLIGHT_MAX_AGE=86400

# LOG_LEVEL — winston log level: error | warn | info | http | verbose | debug | silly (default: info)
LOG_LEVEL=info

# Rate limiting
# RATE_LIMIT_WINDOW_MS — sliding window duration for rate limiting in milliseconds (default: 1 minute)
RATE_LIMIT_WINDOW_MS=60000

# RATE_LIMIT_MAX — max requests per window for public (unauthenticated) endpoints (default: 100)
RATE_LIMIT_MAX=100

# RATE_LIMIT_AUTH_MAX — max requests per window for authenticated (x-api-key) requests (default: 1000)
RATE_LIMIT_AUTH_MAX=1000

# RATE_LIMIT_WRITE_MAX — max requests per window for write/mutation endpoints (default: 10)
RATE_LIMIT_WRITE_MAX=10

# RATE_LIMIT_WRITE_WINDOW_MS — sliding window for write/mutation rate limiting in ms (default: 1 minute)
# RATE_LIMIT_WRITE_WINDOW_MS=60000

# RATE_LIMIT_READ_MAX — max requests per window for read-heavy query endpoints
# (analytics, history, archive, audit) per IP or API key (default: 30) (#394)
RATE_LIMIT_READ_MAX=30

# REQUEST_TIMEOUT_MS — per-request timeout in milliseconds; returns 503 if exceeded (default: 30s)
REQUEST_TIMEOUT_MS=30000

# KEEP_ALIVE_TIMEOUT_MS — HTTP keep-alive timeout on the server socket (default: 35s)
KEEP_ALIVE_TIMEOUT_MS=35000

# HEADERS_TIMEOUT_MS — max time to receive full request headers (default: 40s)
HEADERS_TIMEOUT_MS=40000

# SHUTDOWN_TIMEOUT_MS — graceful shutdown drain window before force-exit (default: 10s)
SHUTDOWN_TIMEOUT_MS=10000

# TRANSACTION_POLL_TIMEOUT_MS — max time to poll Horizon for tx confirmation (#297, default: 60s)
# TRANSACTION_POLL_TIMEOUT_MS=60000

# TRANSACTION_POLL_INTERVAL_MS — delay between Horizon poll attempts (#297, default: 2s)
# TRANSACTION_POLL_INTERVAL_MS=2000

# WEBHOOK_MAX_RETRIES — max delivery attempts per webhook (#295, default: 3)
# WEBHOOK_MAX_RETRIES=3

# WEBHOOK_RETRY_BASE_MS — base backoff for webhook retries (#295, default: 1000)
# WEBHOOK_RETRY_BASE_MS=1000

# WEBHOOK_TIMEOUT_MS — per-request timeout for webhook POST calls (#295, default: 10s)
# WEBHOOK_TIMEOUT_MS=10000

# ─── KYC Provider Integration (#598) ─────────────────────────────────────────
# KYC_VERIFF_WEBHOOK_SECRET — HMAC-SHA256 signing secret from Veriff dashboard
# KYC_VERIFF_WEBHOOK_SECRET=your-veriff-secret

# KYC_JUMIO_WEBHOOK_SECRET — HMAC-SHA256 signing secret from Jumio portal
# KYC_JUMIO_WEBHOOK_SECRET=your-jumio-secret

# Provider callback URL (configure in each provider's dashboard):
#   POST {BASE_URL}/api/v1/kyc/webhook/veriff
#   POST {BASE_URL}/api/v1/kyc/webhook/jumio
# ─── Automated Compliance Reports (#601) ──────────────────────────────────────
# COMPLIANCE_REPORT_RECIPIENTS — comma-separated email recipients for auto-generated reports
# COMPLIANCE_REPORT_RECIPIENTS=admin@example.com,finance@example.com

# COMPLIANCE_REPORTS_DIR — directory to archive generated HTML report files
# COMPLIANCE_REPORTS_DIR=./compliance_reports

# COMPLIANCE_REPORT_CHECK_INTERVAL_MS — how often the scheduler checks (default: hourly)
# COMPLIANCE_REPORT_CHECK_INTERVAL_MS=3600000

# ── Immutable compliance audit trail (#938) ─────────────────────────────────
# Separate append-only, hash-chained SQLite file. Keep it on a volume with
# restricted permissions; it is included in backups by infra/backup-manager.js.
# AUDIT_TRAIL_DB_PATH=./audit-trail.db
# HMAC key for the hash chain. Strongly recommended in production: without it,
# someone with write access to the file could rebuild a valid SHA-256 chain.
# AUDIT_TRAIL_HMAC_KEY=
# AUDIT_TRAIL_RETENTION_DAYS=2557        # 7 years
# AUDIT_TRAIL_VERIFY_INTERVAL_MS=3600000 # full chain verification, hourly
# AUDIT_TRAIL_ALERT_WEBHOOK_URL=         # POSTed to on integrity failure
# AUDIT_TRAIL_ENABLED=true

# ── Metrics (#935) ──────────────────────────────────────────────────────────
# Cap on distinct collaborator label values for earnings/payout metrics.
# METRICS_MAX_COLLABORATOR_SERIES=500

# ── Canary traffic shadowing (#936) ─────────────────────────────────────────
# Set on the STABLE process during a rollout to mirror GET/HEAD requests to
# the canary. Writes are never mirrored. See docs/canary-deployment.md.
# SHADOW_TARGET_URL=http://127.0.0.1:3002
# SHADOW_SAMPLE_RATE=1
# SHADOW_TIMEOUT_MS=5000

# ── Distributed Redis cache (#926) ──────────────────────────────────────────
# When unset, the backend uses its existing in-memory (per-process) cache.
# Set REDIS_URL to share a cache — and cache-invalidation pub/sub — across
# multiple horizontally-scaled backend instances. If Redis is unreachable at
# startup or at any point at runtime, the backend logs a warning and falls
# back to the in-memory cache automatically; it never crashes or blocks on a
# Redis outage.
#
# REDIS_URL — full Redis connection string, e.g.:
#   redis://localhost:6379
#   redis://:password@redis-host:6379/0
#   rediss://user:password@redis-host:6380  (rediss:// implies TLS)
# REDIS_URL=redis://localhost:6379

# REDIS_TLS — set to "true" to force a TLS connection when using a redis://
# URL against a provider that requires TLS on a non-"rediss" scheme (e.g.
# some managed Redis providers). Not needed if REDIS_URL already uses the
# rediss:// scheme. Default: false.
# REDIS_TLS=false
#
# Cache key namespacing: every key written to Redis is prefixed "srs:" plus
# a resource type, e.g. srs:contractState:{contractId}:{tokenId},
# srs:collaborators:{contractId}, srs:analytics:{...}. TTLs per resource
# type: contract state 5m, analytics aggregates 1h, collaborator data 30m,
# session tokens 24h.

# ── Twilio SMS notification channel (#927) ─────────────────────────────────
# When any of these three are unset, sendSms() logs a warning and returns
# { sent: false, reason: "twilio_not_configured" } instead of sending — it
# never throws. SMS is additionally gated per-wallet on an explicit opt-in +
# phone number via POST /api/v1/notifications/sms/preferences; unset Twilio
# config and an un-opted-in wallet both result in a silent no-op.
#
# TWILIO_ACCOUNT_SID — Account SID from the Twilio console
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# TWILIO_AUTH_TOKEN — Auth token from the Twilio console
# TWILIO_AUTH_TOKEN=your-twilio-auth-token

# TWILIO_PHONE — Twilio sender phone number in E.164 format, e.g. +15551234567
# TWILIO_PHONE=+15551234567

# ── OpenSea marketplace webhook integration (#928) ──────────────────────────
# POST {BASE_URL}/api/v1/marketplaces/opensea/webhooks/:contractId
#   (configure one webhook subscription per royalty contract in OpenSea's
#   dashboard, with :contractId set to that contract's Stellar C... address)
#
# OPENSEA_WEBHOOK_SECRET — HMAC-SHA256 signing secret for verifying inbound
# webhook payloads (constant-time compared via crypto.timingSafeEqual).
# Chosen as a separate var from OPENSEA_API_KEY so the webhook secret can be
# rotated independently of the API key used for any outbound OpenSea API
# calls. When unset, signature verification is skipped with a warning
# (development/test only — always set this in production).
# OPENSEA_WEBHOOK_SECRET=your-opensea-webhook-signing-secret

# OPENSEA_API_KEY — API key for outbound calls to the OpenSea API (not used
# for inbound webhook verification; see OPENSEA_WEBHOOK_SECRET above).
# OPENSEA_API_KEY=your-opensea-api-key

# OPENSEA_ROYALTY_RATE_BPS — secondary royalty rate applied to OpenSea resales,
# in basis points out of 10000 (default: 500 = 5%), matching the same scale
# as the on-chain get_royalty_rate() used by the manual secondary-royalty flow.
# OPENSEA_ROYALTY_RATE_BPS=500

# OPENSEA_RELAYER_WALLET — Stellar wallet address used to build the unsigned
# record_secondary_royalty XDR for an OpenSea-detected resale. A webhook has
# no end-user wallet to build against (unlike the manual
# POST /api/v1/secondary-royalty flow), so this wallet stands in as the
# transaction's source account; it does not sign or submit anything — like
# every other route in this backend, only unsigned XDR is built server-side.
# When unset, OpenSea sales are still recorded and broadcast, but no XDR is
# built (logged as "skipped_no_relayer" in marketplace_events.status).
# OPENSEA_RELAYER_WALLET=G...

# OPENSEA_SYNC_MAX_RETRIES / OPENSEA_SYNC_BACKOFF_MS — retry tuning for the
# record_secondary_royalty XDR build step on transient failures (default: 3
# retries, 1000ms base, doubling each attempt).
# OPENSEA_SYNC_MAX_RETRIES=3
# OPENSEA_SYNC_BACKOFF_MS=1000

# ── Rarible marketplace webhook integration (#954) ──────────────────────────
# POST {BASE_URL}/api/v1/marketplaces/rarible/webhooks/:contractId
#   (configure the webhook in Rarible's dashboard with :contractId set to the
#   royalty contract's Stellar C... address). A deployment that registers a
#   single Rarible webhook can instead POST to
#   /api/v1/marketplaces/rarible/webhooks with `contractId` in the body.
# Resales are parsed for both Ethereum and Polygon; any other chain is
# rejected, since the issue scopes this integration to those two.
#
# RARIBLE_WEBHOOK_SECRET — HMAC-SHA256 signing secret for verifying inbound
# webhook payloads (constant-time compared via crypto.timingSafeEqual).
# Separate from RARIBLE_API_KEY so the webhook secret can be rotated
# independently of the key used for any outbound Rarible API calls. When
# unset, signature verification is skipped with a warning (development/test
# only — always set this in production).
# RARIBLE_WEBHOOK_SECRET=your-rarible-webhook-signing-secret

# RARIBLE_API_KEY — API key for outbound calls to the Rarible API (not used
# for inbound webhook verification; see RARIBLE_WEBHOOK_SECRET above).
# RARIBLE_API_KEY=your-rarible-api-key

# RARIBLE_ROYALTY_RATE_BPS — secondary royalty rate applied to Rarible
# resales, in basis points out of 10000 (default: 500 = 5%), matching the
# same scale as the on-chain get_royalty_rate() used by the manual
# secondary-royalty flow.
# RARIBLE_ROYALTY_RATE_BPS=500

# RARIBLE_RELAYER_WALLET — Stellar wallet address used to build the unsigned
# record_secondary_royalty XDR for a Rarible-detected resale. A webhook has
# no end-user wallet to build against (unlike the manual
# POST /api/v1/secondary-royalty flow), so this wallet stands in as the
# transaction's source account; it does not sign or submit anything — like
# every other route in this backend, only unsigned XDR is built server-side.
# When unset, Rarible sales are still recorded and broadcast, but no XDR is
# built (logged as "skipped_no_relayer" in marketplace_events.status).
# RARIBLE_RELAYER_WALLET=G...

# RARIBLE_SYNC_MAX_RETRIES / RARIBLE_SYNC_BACKOFF_MS — retry tuning for the
# record_secondary_royalty XDR build step on transient failures (default: 3
# retries, 1000ms base, doubling each attempt).
# RARIBLE_SYNC_MAX_RETRIES=3
# RARIBLE_SYNC_BACKOFF_MS=1000

# ── Stripe fiat payout integration (#924) ───────────────────────────────────
# Lets a collaborator link a Stripe Connect account and receive XLM earnings
# converted to USD as a fiat payout. When STRIPE_SECRET_KEY is unset, every
# endpoint under /api/v1/payments/stripe returns 503 "stripe_not_configured"
# instead of calling out to Stripe — it never throws.
#
# STRIPE_SECRET_KEY — Stripe secret key (sk_live_... / sk_test_...) used for
# all outbound Stripe API calls (Connect OAuth, payouts, status lookups).
# STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key

# STRIPE_CONNECT_CLIENT_ID — Stripe Connect application client id (ca_...),
# required to build the OAuth "Connect with Stripe" authorize URL a
# collaborator's browser opens via POST /api/v1/payments/stripe/connect.
# STRIPE_CONNECT_CLIENT_ID=ca_your-connect-client-id

# STRIPE_WEBHOOK_SECRET — signing secret from the Stripe Dashboard (or the
# Stripe CLI in development) used to verify the `Stripe-Signature` header on
# inbound webhook events. Configure this endpoint in Stripe's dashboard:
#   POST {BASE_URL}/api/v1/payments/stripe/webhook
# Subscribe it to at least: payout.paid, payout.failed, payout.canceled,
# payout.updated, charge.dispute.*, charge.refunded. When unset, the webhook
# route returns 503 "stripe_webhook_not_configured" and verifies nothing.
# STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret

# ── XLM/USD price oracle (#924, new scope) ──────────────────────────────────
# No price-conversion source existed in this codebase before #924. Used to
# convert a collaborator's XLM payout amount to USD cents before creating the
# Stripe payout. Defaults to CoinGecko's public, keyless simple-price API.
#
# PRICE_ORACLE_URL — override the price source, e.g. to self-host a mirror or
# point at a different provider that returns the same
# `{ "stellar": { "usd": <number> } }` shape.
# PRICE_ORACLE_URL=https://api.coingecko.com/api/v3/simple/price?ids=stellar&vs_currencies=usd
