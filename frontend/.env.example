# VITE_STELLAR_NETWORK — default network shown on first load (testnet | mainnet)
# Users can toggle the network in the UI; this only sets the initial value.
# Testnet (default):
VITE_STELLAR_NETWORK=testnet
# Mainnet:
# VITE_STELLAR_NETWORK=mainnet

# VITE_WALLETCONNECT_PROJECT_ID — WalletConnect Cloud project ID for multi-wallet support (#942)
# Create a free account at cloud.walletconnect.com and create a new project to get this ID.
# Required to enable WalletConnect in the wallet selector.
# VITE_WALLETCONNECT_PROJECT_ID=your-walletconnect-project-id
