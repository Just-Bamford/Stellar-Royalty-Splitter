# ---------------------------------------------------------------------------
# Development environment template
# ---------------------------------------------------------------------------
# Copy to backend/.env (and mirror the VITE_* keys into frontend/.env) for
# local development:
#
#   cp config/env/.env.dev.example backend/.env
#
# This file contains PLACEHOLDERS ONLY and is committed. Never put a real
# secret in any *.example file — backend/.env and frontend/.env are
# gitignored and are the only place real values belong.
#
# Validate with: ./scripts/validate-env.sh
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=3001
DATABASE_PATH=./audit.db
MAX_REQUEST_BODY_SIZE=10kb

# --- Stellar network -------------------------------------------------------
STELLAR_NETWORK=testnet
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
HORIZON_URL=https://horizon-testnet.stellar.org

# Signing identity used by scripts/deploy.sh (a `stellar keys` identity name,
# never a secret key).
STELLAR_IDENTITY=deployer-dev

# Set after scripts/deploy.sh writes .contract-id.
# ROYALTY_CONTRACT_ID=C...

# --- CORS ------------------------------------------------------------------
# Dev may use "*" so any localhost port works; production must not.
FRONTEND_ORIGIN=http://localhost:5173

# --- Request signing -------------------------------------------------------
# Enforcement is off by default in dev so contributors can curl the API
# without signing every request.
SIGNATURE_VERIFICATION_ENABLED=false

# --- Frontend (mirror into frontend/.env) ----------------------------------
VITE_STELLAR_NETWORK=testnet
