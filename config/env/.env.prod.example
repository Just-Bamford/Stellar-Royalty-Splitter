# ---------------------------------------------------------------------------
# Production environment template
# ---------------------------------------------------------------------------
# Production runs against Stellar MAINNET. Real funds move through the
# contract this backend talks to.
#
# This file contains PLACEHOLDERS ONLY and is committed. Real values live in
# the GitHub Environment named `production`, which is protected by a required
# reviewer, and are injected at deploy time — never committed.
#
# Validate with: ./scripts/validate-env.sh
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=production
PORT=3001
DATABASE_PATH=/var/lib/royalty-splitter/audit.db
MAX_REQUEST_BODY_SIZE=10kb
LOG_LEVEL=info

# --- Stellar network -------------------------------------------------------
STELLAR_NETWORK=mainnet
SOROBAN_RPC_URL=https://soroban-mainnet.stellar.org
HORIZON_URL=https://horizon.stellar.org

# `stellar keys` identity name available on the deploy runner. The production
# admin key should be behind multi-sig or a hardware wallet (see SECURITY.md
# § Pre-Deploy Security Checklist).
STELLAR_IDENTITY=deployer-prod

# Contract currently serving production traffic. Under blue-green deployment
# this is the address traffic is cut over to; the previous value is retained
# for the rollback window (see DEPLOYMENT.md § Blue-green deployment).
# ROYALTY_CONTRACT_ID=C...

# --- CORS ------------------------------------------------------------------
# Must be an exact https origin. resolveCorsOrigin() refuses to start when
# NODE_ENV=production and FRONTEND_ORIGIN is unset or "*".
FRONTEND_ORIGIN=https://app.example.com

# --- Request signing -------------------------------------------------------
# Must never be "false" in production: that would let the API accept
# unsigned mutating requests.
SIGNATURE_VERIFICATION_ENABLED=true

# --- Secrets (injected from the GitHub `production` environment) ------------
# Never assign real values here.
#   SIGNING_KEY_FILE   — path to the signing key file on the host
#   ADMIN_ROTATE_TOKEN — bearer token guarding POST /admin/rotate-key
#   SECRETS_PROVIDER   — env | aws | vault (see backend/SECRETS_MANAGER.md)
#   AWS_SECRET_NAME / AWS_REGION           — when SECRETS_PROVIDER=aws
#   VAULT_ADDR / VAULT_TOKEN / VAULT_SECRET_PATH — when SECRETS_PROVIDER=vault
#
# A managed secret store is strongly preferred over plain env vars in
# production.
SECRETS_PROVIDER=aws
# SIGNING_KEY_FILE=
# ADMIN_ROTATE_TOKEN=
# AWS_SECRET_NAME=
# AWS_REGION=

# --- Frontend --------------------------------------------------------------
VITE_STELLAR_NETWORK=mainnet
