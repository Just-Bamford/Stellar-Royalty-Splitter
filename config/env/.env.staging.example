# ---------------------------------------------------------------------------
# Staging environment template
# ---------------------------------------------------------------------------
# Staging runs against Stellar TESTNET but is otherwise configured like
# production: signature enforcement on, an explicit CORS origin, no wildcards.
# It is the environment where a release candidate is proven before promotion.
#
# This file contains PLACEHOLDERS ONLY and is committed. Real values are held
# in the GitHub Environment named `staging` (Settings → Environments) and are
# injected at deploy time — never committed.
#
# Validate with: ./scripts/validate-env.sh
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=production
PORT=3001
DATABASE_PATH=/var/lib/royalty-splitter/audit.db
MAX_REQUEST_BODY_SIZE=10kb

# --- Stellar network -------------------------------------------------------
STELLAR_NETWORK=testnet
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
HORIZON_URL=https://horizon-testnet.stellar.org

# `stellar keys` identity name available on the deploy runner.
STELLAR_IDENTITY=deployer-staging

# Contract currently serving staging traffic. Written by the deploy workflow;
# set as a GitHub Environment variable, not a secret (it is a public address).
# ROYALTY_CONTRACT_ID=C...

# --- CORS ------------------------------------------------------------------
# Must be an exact http(s) origin. "*" is rejected when NODE_ENV=production.
FRONTEND_ORIGIN=https://staging.example.com

# --- Request signing -------------------------------------------------------
SIGNATURE_VERIFICATION_ENABLED=true

# --- Secrets (injected from the GitHub `staging` environment) ---------------
# Never assign real values here. Each maps to a repository/environment secret.
#   SIGNING_KEY_FILE   — path to the signing key file on the host
#   ADMIN_ROTATE_TOKEN — bearer token guarding POST /admin/rotate-key
#   SECRETS_PROVIDER   — env | aws | vault (see backend/SECRETS_MANAGER.md)
#   AWS_SECRET_NAME    — when SECRETS_PROVIDER=aws
#   VAULT_ADDR / VAULT_TOKEN / VAULT_SECRET_PATH — when SECRETS_PROVIDER=vault
# SIGNING_KEY_FILE=
# ADMIN_ROTATE_TOKEN=
SECRETS_PROVIDER=env

# --- Frontend --------------------------------------------------------------
VITE_STELLAR_NETWORK=testnet
